{
  "name": "@ghostlink/common",
  "version": "0.1.0",
  "description": "Shared encodings, hashes, Merkle trees, intent schema and PDA derivation for GhostLink. The fixture vectors in fixtures/vectors.json are the contract between TypeScript, Rust and circom.",
  "keywords": [
    "ghostlink",
    "solana",
    "zero-knowledge",
    "groth16",
    "circom",
    "poseidon",
    "merkle-tree",
    "test-vectors"
  ],
  "homepage": "https://github.com/Ghostlink-Labs/ghostlink/tree/main/packages/common#readme",
  "bugs": {
    "url": "https://github.com/Ghostlink-Labs/ghostlink/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ghostlink-Labs/ghostlink.git",
    "directory": "packages/common"
  },
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "fixtures"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "vectors": "tsx scripts/generate-vectors.ts"
  },
  "dependencies": {
    "@noble/curves": "^1.7.0",
    "@noble/hashes": "^1.6.0",
    "bs58": "^6.0.0",
    "poseidon-lite": "^0.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.12"
  }
}
