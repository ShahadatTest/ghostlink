{
  "name": "@ghostlink/prover-wasm",
  "version": "0.1.0",
  "description": "Browser prover for GhostLink with artifact integrity checks; proves in a Web Worker or on the calling thread.",
  "keywords": [
    "ghostlink",
    "solana",
    "zero-knowledge",
    "groth16",
    "snarkjs",
    "prover",
    "wasm",
    "browser",
    "web-worker"
  ],
  "homepage": "https://github.com/Ghostlink-Labs/ghostlink/tree/main/packages/prover-wasm#readme",
  "bugs": {
    "url": "https://github.com/Ghostlink-Labs/ghostlink/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ghostlink-Labs/ghostlink.git",
    "directory": "packages/prover-wasm"
  },
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "./dist/worker.js"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js",
      "default": "./dist/worker.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "snarkjs": "^0.7.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.6.0",
    "vitest": "^4.1.12"
  }
}
