{
  "name": "@ghostlink/verify",
  "version": "0.1.0",
  "description": "Server-side GhostLink login verification: check a proof, the domain it is bound to, and the roots it was built against — no transaction needed.",
  "keywords": [
    "ghostlink",
    "solana",
    "zero-knowledge",
    "groth16",
    "snarkjs",
    "login",
    "authentication",
    "privacy"
  ],
  "homepage": "https://github.com/Ghostlink-Labs/ghostlink/tree/main/packages/verify#readme",
  "bugs": {
    "url": "https://github.com/Ghostlink-Labs/ghostlink/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ghostlink-Labs/ghostlink.git",
    "directory": "packages/verify"
  },
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./keys/login_vk.json": "./keys/login_vk.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "keys"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ghostlink/common": "workspace:*",
    "@noble/curves": "^1.7.0",
    "snarkjs": "^0.7.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.6.0",
    "vitest": "^4.1.12"
  }
}
