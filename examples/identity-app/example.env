# Identity app configuration. Every variable is optional on a local validator.
# Next.js reads .env.local, which is never committed: copy this file there and edit it,
#   cp example.env .env.local
# or export the variables in your shell before `pnpm dev` / `pnpm start`.
# Values are read on every request, so one build serves any deployment.

# The name shown at the top of every page and in the browser tab.
IDENTITY_APP_NAME=Identity

# The host wallets show in the identity sign-in message. Leave unset to use this app's own host.
# Keep it fixed for a deployment: another host derives another identity from the same wallet.
# IDENTITY_DOMAIN=id.example.com

# The deployment manifest (docs/DEPLOYMENTS.md) as a file path. Unset: the built-in local validator deployment.
# GHOSTLINK_DEPLOYMENT=/path/to/manifest.json

# Services. Defaults are the local stack's (scripts/localnet-e2e.sh with GHOSTLINK_KEEP_RUNNING=1).
GHOSTLINK_INDEXER_URL=http://127.0.0.1:8787
GHOSTLINK_RELAYER_URL=http://127.0.0.1:8788
GHOSTLINK_RPC_URL=http://127.0.0.1:8899

# Proving artifacts, fetched by the browser and checked against these SHA-256 pins before use.
# On a local validator, leave them unset: the app serves circuits/build at /circuits/* itself
# (or GHOSTLINK_CIRCUITS_DIR) and pins the files it serves. Elsewhere the pins are required.
# LOGIN_WASM_URL=https://cdn.example.com/circuits/login.wasm
# LOGIN_ZKEY_URL=https://cdn.example.com/circuits/login.zkey
# LOGIN_WASM_SHA256=<64 hex characters>
# LOGIN_ZKEY_SHA256=<64 hex characters>
# Owner actions (revoke, sweep) need the owner circuit too:
# OWNER_WASM_URL=https://cdn.example.com/circuits/owner.wasm
# OWNER_ZKEY_URL=https://cdn.example.com/circuits/owner.zkey
# OWNER_WASM_SHA256=<64 hex characters>
# OWNER_ZKEY_SHA256=<64 hex characters>
# GHOSTLINK_CIRCUITS_DIR=/path/to/circuits/build

# The longest sign-in session granted to a site, in slots (about 0.4 s each). 9000 is about an hour.
HANDOFF_MAX_SESSION_SLOTS=9000

# 1 adds a development wallet kept in the browser's storage, for trying the app without a wallet
# extension. Local validator only; ignored anywhere else.
IDENTITY_DEV_WALLET=1
