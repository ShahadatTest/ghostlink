{
  "name": "@ghostlink/example-nextjs-login",
  "version": "0.0.0",
  "private": true,
  "description": "A minimal Next.js site with Continue with GhostLink: a nonce route, a verification route and a signed-in page.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
