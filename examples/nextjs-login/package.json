    "e2e": "tsx scripts/handoff-e2e.ts"
  },
  "dependencies": {
    "@ghostlink/common": "workspace:*",
    "@ghostlink/react": "workspace:*",
    "@ghostlink/sdk": "workspace:*",
    "@ghostlink/verify": "workspace:*",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@ghostlink/prover-wasm": "workspace:*",
    "@noble/curves": "^1.7.0",
    "@types/node": "^22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.12"
  }
}
