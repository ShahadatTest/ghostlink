# Starter site configuration. Every variable is optional on a local validator.
# Next.js reads .env.local, which is never committed: copy this file there and edit it,
#   cp example.env .env.local
# or export the variables in your shell before `pnpm dev` / `pnpm start`.

# This site's origin exactly as browsers report it (scheme, host, port; no path or trailing slash).
# Proofs are checked against it, so it must be the address users open.
SITE_ORIGIN=http://localhost:3000

# The identity app the sign-in popup opens: another origin, never this site's.
IDENTITY_ORIGIN=http://localhost:3001

# Your own indexer (login roots) and RPC (current slot). Never take either from the browser.
GHOSTLINK_INDEXER_URL=http://127.0.0.1:8787
GHOSTLINK_RPC_URL=http://127.0.0.1:8899

# Sign-in session length the button asks for and the longest this server accepts, in slots (~0.4 s each).
LOGIN_SESSION_SLOTS=9000

# Optional token gate: members must prove they hold at least GATE_THRESHOLD base units of GATE_MINT
# in a snapshot no older than GATE_MAX_AGE_SLOTS. The mint below is native SOL; 1000000000 is 1 SOL.
# GATE_MINT=So11111111111111111111111111111111111111112
# GATE_THRESHOLD=1000000000
# GATE_MAX_AGE_SLOTS=9000
