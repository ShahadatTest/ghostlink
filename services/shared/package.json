{
  "name": "@ghostlink/service-kit",
  "version": "0.1.0",
  "description": "Shared plumbing for the GhostLink services: anchor instruction encoding, event decoding, precompile builders and a tiny HTTP router. Byte layouts mirror the ones the program integration tests prove on-chain.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ghostlink-Labs/ghostlink.git",
    "directory": "services/shared"
  },
  "homepage": "https://github.com/Ghostlink-Labs/ghostlink/tree/main/services/shared#readme",
  "bugs": {
    "url": "https://github.com/Ghostlink-Labs/ghostlink/issues"
  },
  "keywords": [
    "ghostlink",
    "solana",
    "anchor",
    "event-decoding",
    "rpc"
  ],
  "engines": {
    "node": "^22.16.0 || ^24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "exports": {
    ".": "./dist/index.js",
    "./accounts": "./dist/accounts.js",
    "./storage": "./dist/storage.js",
    "./rpc": "./dist/rpc.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ghostlink/common": "workspace:*",
    "@noble/curves": "^1.7.0",
    "@noble/hashes": "^1.6.0",
    "@solana/web3.js": "^1.95.0",
    "bs58": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.6.0",
    "vitest": "^4.1.12"
  }
}
